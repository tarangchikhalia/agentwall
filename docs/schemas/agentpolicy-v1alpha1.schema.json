{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentWall AgentPolicy v1alpha1",
  "description": "Structural schema; mandatory source, byte, depth, identity and integer-range checks are defined in ../policy-schema-v1alpha1.md.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agentwall.dev/v1alpha1"
    },
    "kind": {
      "const": "AgentPolicy"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "string": {
      "type": "string",
      "maxLength": 2048
    },
    "scalar": {
      "oneOf": [
        {
          "$ref": "#/$defs/string"
        },
        {
          "$ref": "#/$defs/int64"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9-]"
      }
    },
    "metadataValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadataValue"
          }
        },
        {
          "$ref": "#/$defs/metadataObject"
        }
      ]
    },
    "metadataObject": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "additionalProperties": {
        "$ref": "#/$defs/metadataValue"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "additionalProperties": {
        "$ref": "#/$defs/metadataValue"
      }
    },
    "resourcePattern": {
      "type": "string",
      "maxLength": 2048,
      "allOf": [
        {
          "pattern": "^(?:[^/*]+|\\*)(?:/(?:[^/*]+|\\*))*(?:/\\*\\*)?$|^\\*\\*$"
        },
        {
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        }
      ]
    },
    "absolutePattern": {
      "type": "string",
      "maxLength": 2048,
      "allOf": [
        {
          "pattern": "^/(?:$|(?:[^/*]+|\\*)(?:/(?:[^/*]+|\\*))*(?:/\\*\\*)?$|\\*\\*$)"
        },
        {
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/resourcePattern"
            },
            {
              "$ref": "#/$defs/absolutePattern"
            }
          ]
        },
        "resource": {
          "$ref": "#/$defs/resourcePattern"
        },
        "apiPath": {
          "$ref": "#/$defs/absolutePattern"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "bounds": {
      "type": "object",
      "properties": {
        "gt": {
          "$ref": "#/$defs/int64"
        },
        "gte": {
          "$ref": "#/$defs/int64"
        },
        "lt": {
          "$ref": "#/$defs/int64"
        },
        "lte": {
          "$ref": "#/$defs/int64"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1,
      "allOf": [
        {
          "not": {
            "required": [
              "gt",
              "gte"
            ]
          }
        },
        {
          "not": {
            "required": [
              "lt",
              "lte"
            ]
          }
        }
      ]
    },
    "membership": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "oneOf": [
        {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/string"
              },
              {
                "type": "null"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/string"
          }
        },
        {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/int64"
              },
              {
                "type": "null"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/int64"
          }
        },
        {
          "items": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "contains": {
            "type": "boolean"
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
              "not": {
                "pattern": "[^A-Za-z0-9_.]"
              }
            },
            "operator": {
              "enum": [
                "eq",
                "neq"
              ]
            },
            "value": {
              "$ref": "#/$defs/scalar"
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
              "not": {
                "pattern": "[^A-Za-z0-9_.]"
              }
            },
            "operator": {
              "enum": [
                "in",
                "notIn"
              ]
            },
            "value": {
              "$ref": "#/$defs/membership"
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
              "not": {
                "pattern": "[^A-Za-z0-9_.]"
              }
            },
            "operator": {
              "enum": [
                "startsWith"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
              "not": {
                "pattern": "[^A-Za-z0-9_.]"
              }
            },
            "operator": {
              "enum": [
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "value": {
              "$ref": "#/$defs/int64"
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
              "not": {
                "pattern": "[^A-Za-z0-9_.]"
              }
            },
            "operator": {
              "enum": [
                "range"
              ]
            },
            "value": {
              "$ref": "#/$defs/bounds"
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "always": {
              "const": true
            }
          },
          "required": [
            "always"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "effect": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "required": [
        "id",
        "effect",
        "scope",
        "condition"
      ],
      "additionalProperties": false
    }
  }
}
